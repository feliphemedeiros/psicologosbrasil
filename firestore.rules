rules_version = '2';

// Regras de segurança do Firebase — Psicólogos Brasil
// Cole TODO este texto em: Firebase > Firestore Database > Regras > Publicar.
//
// Resumo:
// - Qualquer visitante pode LER o que está publicado (artigos, psicólogos, imagens).
// - Só pode ESCREVER quem fez login E está na lista "admins".
// - Os rascunhos do painel só podem ser lidos pelos admins.
// - Ninguém consegue se colocar sozinho na lista "admins" (só você, pelo site do Firebase).

service cloud.firestore {
  match /databases/{database}/documents {

    function ehAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Conteúdo público do site
    match /indice/{tipo}     { allow read: if true; allow write: if ehAdmin(); }
    match /artigos/{slug}    { allow read: if true; allow write: if ehAdmin(); }
    match /imagens/{id}      { allow read: if true; allow write: if ehAdmin(); }

    // Rascunhos e configurações do painel (privado)
    match /painel_artigos/{id}    { allow read, write: if ehAdmin(); }
    match /painel_psicologos/{id} { allow read, write: if ehAdmin(); }
    match /painel_config/{id}     { allow read, write: if ehAdmin(); }

    // Lista de quem pode usar o painel: cada um só confere o próprio cadastro
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Qualquer outra coisa: bloqueado
    match /{documento=**} { allow read, write: if false; }
  }
}
